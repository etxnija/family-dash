<!doctype html>
<html lang="sv">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="300">
<title>Family Dashboard</title>
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: "Courier New", Courier, monospace;
    background: #d5d5d5;
    color: #000;
    min-height: 100vh;
    padding: 40px 0;
    display: flex;
    justify-content: center;
  }
  .sheet {
    position: relative;
    background: #fdfdfb;
    max-width: 700px;
    width: 100%;
    padding: 50px;
    margin: 0 20px;
  }
  .corner {
    position: absolute;
    width: 8px;
    height: 8px;
    background: #000;
  }
  .corner.tl { top: 14px; left: 14px; }
  .corner.tr { top: 14px; right: 14px; }
  .corner.bl { bottom: 14px; left: 14px; }
  .corner.br { bottom: 14px; right: 14px; }
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .header .today {
    font-size: 28px;
    font-weight: bold;
  }
  .header .week {
    font-size: 14px;
  }
  .owners {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-top: 10px;
  }
  hr {
    border: none;
    border-top: 1px solid #000;
    margin: 20px 0;
  }
  .clock-weather {
    display: flex;
    align-items: center;
  }
  .clock {
    flex: 1;
    font-size: 80px;
    font-weight: bold;
    line-height: 1;
  }
  .weather {
    flex: 1;
    border-left: 1px solid #000;
    padding-left: 20px;
    text-align: center;
  }
  .weather .temp {
    font-size: 32px;
    font-weight: bold;
  }
  .weather .source {
    font-size: 12px;
  }
  h2 {
    font-size: 15px;
    font-weight: bold;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .row {
    margin: 4px 0;
  }
  .muted {
    color: #666;
    font-size: 12px;
  }
</style>
</head>
<body>

<div class="sheet">
  <span class="corner tl"></span>
  <span class="corner tr"></span>
  <span class="corner bl"></span>
  <span class="corner br"></span>

  <div class="header">
    <div class="today">{{svWeekday .Weekday}} {{svDateLabel .DateLabel}}</div>
    <div class="week">v.{{.WeekNumber}}</div>
  </div>

  <div class="owners">{{range $i, $o := .Owners}}{{if $i}} &middot; {{end}}{{$o}}{{end}}</div>

  <hr>

  <div class="clock-weather">
    <div class="clock">{{.CurrentTime}}</div>
    <div class="weather">
      {{if .Weather}}
      <div class="temp">{{temperatureDisplay .Weather.Temperature}}</div>
      <div class="source">SMHI</div>
      <div class="source">L&auml;gst idag: {{temperatureDisplay .Weather.LowTemperature}} &middot; H&ouml;gst idag: {{temperatureDisplay .Weather.HighTemperature}}</div>
      <div class="source">{{if .Weather.Sunny}}Sol{{else}}Mulet{{end}}</div>
      <div class="source">{{if .Weather.PrecipitationExpected}}regn idag{{else}}torrt idag{{end}}</div>
      {{else}}
      <div class="temp">&mdash;&deg;</div>
      <div class="source">ingen v&auml;derk&auml;lla</div>
      {{end}}
    </div>
  </div>

  <hr>

  <h2>Skollunch</h2>
  {{if not .Lunch}}
  <div class="row muted">Ingen lunchmeny idag.</div>
  {{end}}
  {{range .Lunch}}
  <div class="row">{{.}}</div>
  {{end}}

  <hr>

  <h2>Idag</h2>
  {{if not .Events}}
  <div class="row muted">Inget planerat idag.</div>
  {{end}}
  {{range .Events}}
  <div class="row"><b>{{svTime .Time}}</b>&nbsp;&nbsp;{{.Owner}} &ndash; {{.Summary}}{{if .Location}}, {{.Location}}{{end}}</div>
  {{if .Description}}<div class="row muted">{{.Description}}</div>{{end}}
  {{end}}

  <hr>

  <h2>L&auml;xor och Prov</h2>
  {{if not .Homework}}
  <div class="row muted">Inga l&auml;xor den h&auml;r veckan.</div>
  {{end}}
  {{range $group := .Homework}}
  {{range $group.Items}}
  <div class="row"><b>{{ownerInitial $group.Owner}}</b>&nbsp;&nbsp;{{.Summary}}{{if .IsProv}} <span class="muted">(Prov)</span>{{end}} &ndash; {{svDayLabel .DayLabel}}</div>
  {{end}}
  {{end}}

  <hr>

  <h2>Kommande dagar</h2>
  {{if not .Upcoming}}
  <div class="row muted">Inga aktiviteter de kommande dagarna.</div>
  {{end}}
  {{range .Upcoming}}
  <div class="row">{{svWeekdayAbbrev .Weekday}}&nbsp;&nbsp;{{.Owner}} &ndash; {{.Summary}}{{if .Location}}, {{.Location}}{{end}}{{if ne (svTime .Time) "heldag"}}, {{svTime .Time}}{{end}}{{if eq (svTime .Time) "heldag"}}, heldag{{end}}</div>
  {{end}}

</div>

</body>
</html>
