<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="300">
<title>Family Dashboard</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Manrope:wght@400;600;700;800&display=swap">
<style>
  :root {
    --bg: oklch(0.97 0.012 80);
    --card: oklch(0.995 0.004 80);
    --row: oklch(0.985 0.006 80);
    --border: oklch(0.89 0.012 80);
    --text: oklch(0.23 0.02 65);
    --muted: oklch(0.53 0.02 65);
    --kaj: oklch(0.6 0.12 175);
    --lillian: oklch(0.68 0.15 55);
    --family: oklch(0.5 0.02 250);
    --sun: oklch(0.72 0.14 75);
    --weather: oklch(0.5 0.05 235);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding: 32px 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  a { color: var(--kaj); }
</style>
</head>
<body>

  <div style="display:flex; align-items:center; justify-content:space-between; gap:20px; flex-shrink:0;">
    <div>
      <div style="font-size:14px; font-weight:800; letter-spacing:0.16em; text-transform:uppercase; color:var(--muted);">Today</div>
      <div style="font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size:42px; font-weight:700; line-height:1.05; margin-top:2px;">
        {{.Weekday}} <span style="font-weight:500; color:var(--muted); font-size:25px;">{{.DateLabel}}</span>
      </div>
    </div>

    <div style="display:flex; align-items:center; gap:18px; margin-left:auto;">

      <div style="display:flex; align-items:center; gap:12px; background:var(--card); border:1px solid var(--border); border-radius:18px; padding:10px 18px; color:var(--weather);">
        <svg viewBox="0 0 28 24" width="30" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
          <circle cx="9" cy="8" r="4"></circle>
          <path d="M9 1.5v2M9 12.5v0M1.5 8h2M2.9 3.4l1.4 1.4M2.9 12.6l1.4-1.4"></path>
          <path d="M13 19.5a4.2 4.2 0 0 1 .3-8.4A5.4 5.4 0 0 1 23.8 13a3.7 3.7 0 0 1-1 6.5H13Z"></path>
        </svg>
        <div>
          <div style="font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size:26px; font-weight:700; line-height:1; color:var(--text);">&mdash;&deg;</div>
          <div style="font-size:11px; color:var(--muted); margin-top:2px;">No weather source yet</div>
        </div>
      </div>

      <div style="display:flex; gap:8px;">
        {{range .Owners}}
        <div style="display:flex; align-items:center; gap:7px; background:var(--card); border:1px solid var(--border); border-radius:999px; padding:8px 13px 8px 10px;">
          <span style="width:11px; height:11px; border-radius:50%; background:var({{ownerColor .}}); flex-shrink:0;"></span>
          <span style="font-size:14px; font-weight:700;">{{.}}</span>
        </div>
        {{end}}
      </div>
    </div>
  </div>

  <div style="display:flex; gap:20px; flex:1; min-height:0;">

    <div style="flex:1.4; background:var(--card); border:1px solid var(--border); border-radius:22px; padding:24px 26px; display:flex; flex-direction:column; gap:14px; min-width:0;">
      <div style="font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size:21px; font-weight:700;">Today's schedule</div>

      <div style="display:flex; flex-direction:column; gap:10px;">
        {{if not .Events}}
        <div style="padding:11px 14px; color:var(--muted); font-size:15px;">Nothing scheduled today.</div>
        {{end}}
        {{range .Events}}
        <div style="display:flex; align-items:center; gap:14px; padding:11px 14px; border-radius:16px; background:var(--row);">
          <div style="width:5px; align-self:stretch; border-radius:3px; background:var({{ownerColor .Owner}}); flex-shrink:0;"></div>
          <div style="font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size:18px; font-weight:700; width:58px; flex-shrink:0;">{{.Time}}</div>
          <div style="width:38px; height:38px; border-radius:12px; background:color-mix(in oklch, var({{ownerColor .Owner}}) 16%, white); display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var({{ownerColor .Owner}});">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17M3.9 8h16.2M3.9 16h16.2"></path></svg>
          </div>
          <div style="flex:1; min-width:0;">
            <div style="font-size:17px; font-weight:700;">{{.Summary}}</div>
            <div style="font-size:13px; color:var(--muted); margin-top:2px;">{{.Location}} &middot; {{.TimeRange}}</div>
          </div>
          <div style="font-size:12px; font-weight:700; color:var({{ownerColor .Owner}}); background:color-mix(in oklch, var({{ownerColor .Owner}}) 14%, white); padding:6px 13px; border-radius:999px; flex-shrink:0;">{{.Owner}}</div>
        </div>
        {{end}}
      </div>
    </div>

    <div style="flex:1; background:var(--card); border:1px solid var(--border); border-radius:22px; padding:24px 24px; display:flex; flex-direction:column; gap:18px; min-width:0;">
      <div style="font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size:21px; font-weight:700;">School today</div>
      <div style="font-size:13px; color:var(--muted);">Placeholder &mdash; no school-hours data source yet</div>

      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="width:10px; height:10px; border-radius:50%; background:var(--kaj); flex-shrink:0;"></span>
          <span style="font-size:15px; font-weight:700;">Kaj</span>
        </div>
        <div style="display:flex; flex-direction:column; gap:8px; padding:12px 14px; border-radius:14px; background:var(--row);">
          <div style="display:flex; align-items:center; gap:9px;">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--muted)" stroke-width="1.8" style="flex-shrink:0;"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.3 1.9"></path></svg>
            <span style="font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size:16px; font-weight:700;">08:20&ndash;15:10</span>
          </div>
          <div style="display:flex; align-items:center; gap:9px;">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--muted)" stroke-width="1.8" style="flex-shrink:0;"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4"></circle></svg>
            <span style="font-size:14px; color:var(--muted);">Fish gratin &amp; peas</span>
          </div>
        </div>
      </div>

      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="width:10px; height:10px; border-radius:50%; background:var(--lillian); flex-shrink:0;"></span>
          <span style="font-size:15px; font-weight:700;">Lillian</span>
        </div>
        <div style="display:flex; flex-direction:column; gap:8px; padding:12px 14px; border-radius:14px; background:var(--row);">
          <div style="display:flex; align-items:center; gap:9px;">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--muted)" stroke-width="1.8" style="flex-shrink:0;"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.3 1.9"></path></svg>
            <span style="font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size:16px; font-weight:700;">08:10&ndash;13:40</span>
          </div>
          <div style="display:flex; align-items:center; gap:9px;">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="var(--muted)" stroke-width="1.8" style="flex-shrink:0;"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4"></circle></svg>
            <span style="font-size:14px; color:var(--muted);">Veggie tacos</span>
          </div>
        </div>
      </div>
    </div>

    <div style="flex:1.1; background:var(--card); border:1px solid var(--border); border-radius:22px; padding:24px 24px; display:flex; flex-direction:column; gap:18px; min-width:0;">
      <div>
        <div style="font-family:'Space Grotesk', ui-sans-serif, system-ui, sans-serif; font-size:21px; font-weight:700;">Homework due</div>
        <div style="font-size:13px; color:var(--muted); margin-top:2px;">Placeholder &mdash; no homework data source yet</div>
      </div>

      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="width:10px; height:10px; border-radius:50%; background:var(--kaj); flex-shrink:0;"></span>
          <span style="font-size:15px; font-weight:700;">Kaj</span>
        </div>
        <div style="display:flex; align-items:flex-start; gap:11px; padding:11px 13px; border-radius:14px; background:var(--row);">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--muted)" stroke-width="1.8" style="margin-top:2px; flex-shrink:0;"><circle cx="12" cy="12" r="9"></circle></svg>
          <div style="flex:1;">
            <div style="font-size:15px; font-weight:700;">Math worksheet</div>
            <div style="font-size:13px; color:var(--text); margin-top:2px; font-weight:600;">Due today</div>
          </div>
        </div>
        <div style="display:flex; align-items:flex-start; gap:11px; padding:11px 13px; border-radius:14px; background:var(--row);">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--muted)" stroke-width="1.8" style="margin-top:2px; flex-shrink:0;"><circle cx="12" cy="12" r="9"></circle></svg>
          <div style="flex:1;">
            <div style="font-size:15px; font-weight:700;">Read ch. 4 &ndash; English</div>
            <div style="font-size:13px; color:var(--muted); margin-top:2px;">Due tomorrow</div>
          </div>
        </div>
      </div>

      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="width:10px; height:10px; border-radius:50%; background:var(--lillian); flex-shrink:0;"></span>
          <span style="font-size:15px; font-weight:700;">Lillian</span>
        </div>
        <div style="display:flex; align-items:flex-start; gap:11px; padding:11px 13px; border-radius:14px; background:var(--row);">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--muted)" stroke-width="1.8" style="margin-top:2px; flex-shrink:0;"><circle cx="12" cy="12" r="9"></circle></svg>
          <div style="flex:1;">
            <div style="font-size:15px; font-weight:700;">Spelling words</div>
            <div style="font-size:13px; color:var(--text); margin-top:2px; font-weight:600;">Due today</div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div style="display:flex; flex-direction:column; gap:10px; flex-shrink:0;">
    <div style="font-size:13px; font-weight:800; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted);">Coming up &mdash; placeholder</div>
    <div style="display:flex; gap:16px;">
      <div style="flex:1; background:var(--row); border:1px dashed var(--border); border-radius:16px; padding:13px 18px; display:flex; flex-direction:column; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="width:9px; height:9px; border-radius:50%; background:var(--lillian); flex-shrink:0;"></span>
          <span style="font-size:14px; font-weight:700;">Wednesday</span>
        </div>
        <div style="font-size:14px; color:var(--muted);">Lillian &ndash; Soccer game, away &middot; 10:00</div>
      </div>
      <div style="flex:1; background:var(--row); border:1px dashed var(--border); border-radius:16px; padding:13px 18px; display:flex; flex-direction:column; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="width:9px; height:9px; border-radius:50%; background:var(--kaj); flex-shrink:0;"></span>
          <span style="font-size:14px; font-weight:700;">Thursday</span>
        </div>
        <div style="font-size:14px; color:var(--muted);">Kaj &ndash; Floorball tournament, all day</div>
      </div>
      <div style="flex:1; background:var(--row); border:1px dashed var(--border); border-radius:16px; padding:13px 18px; display:flex; flex-direction:column; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="width:9px; height:9px; border-radius:50%; background:var(--family); flex-shrink:0;"></span>
          <span style="font-size:14px; font-weight:700;">Friday</span>
        </div>
        <div style="font-size:14px; color:var(--muted);">Family &ndash; Movie night</div>
      </div>
    </div>
  </div>

</body>
</html>
